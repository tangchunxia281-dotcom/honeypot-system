# Documentation template only. This application does NOT automatically load .env.
# Prefer 启动比赛版.cmd and honeypot.ini / ai.local.ini.
# Set temporary variables in the current shell if needed; values override base INI.
# Do not copy literal placeholder secrets into a running system.
HONEYPOT_CONFIG=honeypot.ini
PRODUCTION_MODE=true
ADMIN_USER=admin
# ADMIN_PASS=SET_LOCALLY_AT_LEAST_12_CHARACTERS
# SECRET_KEY=GENERATE_LOCALLY_DO_NOT_COMMIT
WEB_HOST=127.0.0.1
WEB_PORT=5000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001
SSH_HOST=127.0.0.1
SSH_PORT=2222
DB_TYPE=sqlite
DB_PATH=database/event_logs.db
# Local AI uses ai.local.ini; copy from ai.local.ini.example or use the UI wizard.

# Optional cloud provider: configure in UI, or set these explicitly.
# HONEYPOT_AI_PROVIDER=deepseek
# HONEYPOT_AI_BASE_URL=https://api.deepseek.com
# HONEYPOT_AI_MODEL=deepseek-chat
# HONEYPOT_AI_API_KEY=SET_LOCALLY_DO_NOT_COMMIT
# Optional classifier settings file; weights and external service are separate.
# HONEYPOT_CLASSIFIER_CONFIG=classifier.ini
