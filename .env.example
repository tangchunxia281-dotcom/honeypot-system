# ============================================================
# 环境变量模板（复制为 .env 或由 systemd EnvironmentFile 加载）
# ============================================================
# 读取优先级：环境变量 > 根目录 honeypot.ini > 代码默认值。
# 因此这里只需填写「需要覆盖 ini 的项」，不要重复抄写全部默认值。
#
# 本文件是模板，不含任何真实密钥；请勿把填好的 .env 提交到仓库。

# ---- 配置文件位置 ----
HONEYPOT_CONFIG=./honeypot.ini
HONEYPOT_AI_CONFIG=./ai.local.ini
PYTHONUNBUFFERED=1
SYSTEMD_SERVICE_NAME=honeypot

# ---- 运行模式 ----
# 生产模式必须同时设置 HONEYPOT_ADMIN_PASSWORD
HONEYPOT_PRODUCTION_MODE=false
HONEYPOT_ADMIN_USER=admin
HONEYPOT_ADMIN_PASSWORD=
HONEYPOT_SECRET_KEY=

# ---- 服务端口（如需改端口时填写）----
# SSH_PORT=2222
# WEB_PORT=5000
# DASHBOARD_PORT=5001
# DB_HONEYPOT_MYSQL_PORT=13306
# DB_HONEYPOT_REDIS_PORT=16379
# FILE_HONEYPOT_PORT=2121
# REMOTE_HONEYPOT_PORT=2223

# ---- 数据库 ----
# DB_TYPE=sqlite
# DB_PATH=./database/event_logs.db
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=honeypot

# ---- 请求级 AI 检测服务（可选）----
# AI_XSS_ENABLED=true
# AI_XSS_URL=http://127.0.0.1:8003/api/v1/detect
# AI_XSS_TIMEOUT=2.0
# AI_DETECT_SERVICE_ENABLED=true

# ---- 通用大模型（可选，亦可写在 ai.local.ini）----
# HONEYPOT_AI_ENABLED=true
# HONEYPOT_AI_PROVIDER=deepseek
# 建议用环境变量注入密钥，避免落盘
# HONEYPOT_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# HONEYPOT_AI_MODEL=deepseek-chat

# ---- 告警（可选）----
# ALERT_ENABLED=false
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# ---- 其他 ----
# LOG_LEVEL=INFO
# ALLOW_DASHBOARD_MOCK_DATA=false
