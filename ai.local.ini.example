[ai]
# 本地模型连接、受控交互、攻击研判和日志分析；配置模型名需与 ollama list 一致。
enabled = false
ssh_enabled = false
base_url = http://127.0.0.1:11434
model = 
timeout = 10
concurrency = 1
max_calls_per_session = 10
min_interval = 2
think = false
context_length = 4096
max_output_tokens = 256
runtime_db = database/ai_runtime.db
detection_enabled = false
detection_queue_max = 32
detection_per_ip_hour = 20
normal_sample_every = 10

web_interaction_enabled = true
interaction_ttl = 1800
interaction_sessions = 128
interaction_steps = 100
interaction_per_ip_hour = 40

analysis_enabled = false
analysis_timeout = 20
interactive_wait = 2
detection_delay = 3

analysis_batch = 24
analysis_samples = 6
analysis_flush = 60
analyst_retention_days = 30

provider = local
periodic_enabled = false

# -1: Ollama automatic; 0: CPU; positive values: partial GPU offload.
gpu_layers = -1
