# 网络威胁态势感知与蜜罐诱捕系统统一配置示例
#
# 读取顺序：环境变量 > 根目录 honeypot.ini > 代码默认值。
# 使用时复制为 honeypot.ini，并按需修改。不要把真实 honeypot.ini 提交或公开。

[app]
# true/yes/on/1 视为生产模式；生产模式必须设置 [admin] password。
production_mode = false
# 建议生产环境设置稳定 secret_key；留空时会读取 .secret_key 或临时生成。
secret_key =
log_level = INFO
log_max_bytes = 10485760
log_backup_count = 30
show_credential_logs = false
show_summary_creds = true
show_demo_credentials = true
emit_credential_lines = false
summary_cred_wait = 2
summary_cred_wait_max = 15
max_restart_attempts = 5
restart_delay = 3

[admin]
user = admin
# 生产模式必填；非生产模式留空时使用本地演示默认密码 Admin@2024!
password =

[services.ssh]
host = 0.0.0.0
port = 2222
internal_ip = 10.0.12.10
max_workers = 80
max_auth_tries = 5
max_concurrent_connections = 50
max_connections_per_ip = 5
connection_timeout = 30
auth_timeout = 10
sudo_cache_ttl = 300
bruteforce_ban_enabled = true
bruteforce_window_seconds = 60
bruteforce_max_fails = 12
bruteforce_base_ban_seconds = 600
bruteforce_max_ban_seconds = 7200
bruteforce_gc_interval_seconds = 60
bruteforce_stale_keep_seconds = 3600
scan_detect_enabled = true
scan_window_seconds = 10
scan_conn_threshold = 18
scan_alert_cooldown_seconds = 120
scan_stale_keep_seconds = 1800

[services.web]
host = 0.0.0.0
port = 5000
max_content_length = 2097152
max_form_memory_size = 524288
max_form_parts = 200
max_url_path_len = 1024
max_query_len = 4096
max_headers_total = 16384
max_headers_count = 100
trusted_proxy_ips = 127.0.0.1,::1
admin_allowed_origins =
capture_body_max = 8192
admin_sid_cookie = cms_admin_sid

[services.web.decoy_root]
enabled = true
username = root
role = 超级管理员
status = 启用
email = root@company.com
last_login = auto
id = 0
active_recent_minutes = 15

[services.dashboard]
host = 127.0.0.1
port = 5001
allowed_origins =
trusted_proxy_ips = 127.0.0.1,::1
trust_proxy_headers = false
session_lifetime_minutes = 1440
session_cookie_secure = false
login_rate_window = 60
login_rate_max = 8
login_block_seconds = 300
login_audit_max = 200
login_audit_recent = 30
asset_version =

[database]
type = sqlite
# 相对路径按项目根目录解析
path = ./database/event_logs.db
host = 127.0.0.1
port = 3306
user = root
# 生产模式且 type=mysql 时必填
password =
name = honeypot_db
charset = utf8mb4
sqlite_busy_retry = 3
sqlite_busy_backoff = 0.05
session_id_window_seconds = 3600
has_real_cache_ttl = 0.5

[alerting]
enabled = false
# 企业微信机器人 Webhook。真实地址只写入本地 honeypot.ini，不要写入示例或公开仓库。
webhook_url =
timeout = 3.0
min_interval = 3.0
dedup_window = 60
risk_threshold = 40
high_threshold = 60
critical_threshold = 80
mention_all = false
retry = 1
detail_url =
detail_url_enabled = false
msg_max_bytes = 3900
async_enabled = true
queue_max = 1000
queue_drop_oldest = true
workers = 1

[events]
payload_max = 2048
extra_max = 4096
query_batch = 1000
stats_cache_ttl = 3
stats_cache_max_keys = 16
dedup_window = 2.5
dedup_max = 4096

[archive]
hot_days = 7
check_interval_seconds = 300
background_interval_seconds = 3600
read_enabled = true
query_max_files = 60

[geoip]
timeout = 2.5
server_location_cache_ttl = 300
server_public_ip_cache_max_age = 86400
server_public_ip =
mem_cache_ttl = 300
mem_cache_neg_ttl = 15
mem_cache_max = 2048
map_top_ip_scan_limit = 60
map_scan_multiplier = 4
map_online_resolve_limit = 1

[security]
trusted_proxy_ips = 127.0.0.1,::1
trust_proxy_headers = false

[dashboard_data]
allow_mock_data = false

[demo]
# 答辩/远程测试脚本默认目标，可按需要改为云服务器 IP。
target_host = 10.10.10.10
web_scheme = http
dashboard_scheme = http

[tests.performance]
api_calls = 500
concurrency = 100
total_requests = 100
timeout = 4.0
settle_seconds = 2.0

[tests.sqli]
attack_count = 100
benign_count = 30
send_interval = 0.4
settle_seconds = 2.0
query_hours = 2
timeout = 4.0
