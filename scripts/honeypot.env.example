# ================================
# Honeypot compatibility env file
# ================================
#
# 主配置已集中到项目根目录 honeypot.ini，由 app_config.py 读取。
# 本文件仅保留给旧部署方式 / systemd EnvironmentFile 兼容使用。
# 环境变量优先级高于 honeypot.ini；不要在这里重复写大量默认值，否则会覆盖根配置。

HONEYPOT_CONFIG=./honeypot.ini
PYTHONUNBUFFERED=1
SYSTEMD_SERVICE_NAME=honeypot

# 临时覆盖示例（按需取消注释）：
# WEB_PORT=5000
# DASHBOARD_PORT=5001
# ADMIN_PASS=ChangeMe_StrongPassword!
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx
